{
  "name": "dsh-deep-ptc-mode",
  "version": "1.3.1",
  "description": "Deep PTC with visible progress, scoped verification, lifecycle-aware background work and selectable WSL, PowerShell, Bash or Zsh execution.",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "ptc",
    "agent-team",
    "subagent",
    "clarification"
  ],
  "license": "MIT",
  "author": {
    "name": "lishize20040802-rgb",
    "email": "lishize20040802@gmail.com",
    "url": "https://github.com/lishize20040802-rgb"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lishize20040802-rgb/dsh-deep-ptc-mode.git"
  },
  "homepage": "https://github.com/lishize20040802-rgb/dsh-deep-ptc-mode#readme",
  "bugs": {
    "url": "https://github.com/lishize20040802-rgb/dsh-deep-ptc-mode/issues"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "compatibility.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "assets/icon.png"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./executor": "./lib/executor.mjs",
    "./terminal": "./lib/terminal.mjs",
    "./environment": "./lib/environment.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "check:upstream": "node scripts/check.mjs --upstream",
    "prepack": "npm run check && npm test"
  },
  "devDependencies": {
    "js-yaml": "4.3.2",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-bash-local": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-bash-sandbox": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-bash": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-bash-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-bash-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-bash": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    }
  }
}
